     gray  = np.array(pil_g, dtype=np.float32) / 255.0
 
+    # Compute edge density for the adaptive baseline
+    import cv2 as _cv2
+    edges = _cv2.Canny((gray * 255).astype(np.uint8), 50, 150)
+    edge_density = float(np.sum(edges > 0) / edges.size)
